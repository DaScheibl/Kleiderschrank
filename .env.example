# Vorlage für die App. Kopieren nach ".env" und ausfüllen. ".env" wird nie eingecheckt.
#
# Alles, was mit EXPO_PUBLIC_ beginnt, landet im App-Bundle und ist für jeden lesbar.
# Hier stehen deshalb NUR Werte, die öffentlich sein dürfen. Geheime Schlüssel
# (Service-Rolle, KI-Anbieter, Webhook) gehören ausschließlich in die Edge Functions,
# siehe supabase/functions/.env.example.

# Projekt-URL aus dem Supabase-Dashboard (Connect bzw. Project Settings > API),
# Form: https://<projekt-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable Key (beginnt mit "sb_publishable_"; in älteren Projekten heißt er "anon key").
# Er darf in die App, weil Row Level Security jeden Zugriff auf die eigenen Zeilen begrenzt.
# NIEMALS hier eintragen: Secret Key ("sb_secret_...") oder "service_role key".
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
